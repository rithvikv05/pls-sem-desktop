{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "pls-sem",
  "version": "0.1.0",
  "identifier": "com.punyapratap.pls-sem-desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5185",
    "beforeDevCommand": "cd frontend && npm run dev",
    "beforeBuildCommand": "cd frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "pls-sem",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
